---
import Base from "../layouts/Base.astro";
import BookingForm from "../components/BookingForm.astro";

export const prerender = false;
---

<Base title="Booking Service Demo - Book Appointments Online">
	<section class="hero">
		<h1>Book Your Appointment Online</h1>
		<p class="hero__lead">
			Easily schedule consultations, strategy sessions, and follow-up meetings with our expert team.
		</p>
	</section>

	<BookingForm />
</Base>

<style>
	.hero {
		text-align: center;
		padding: 3rem 0;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 2rem;
	}

	.hero h1 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: var(--color-text);
	}

	.hero__lead {
		font-size: 1.25rem;
		color: var(--color-text-secondary);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.6;
	}
</style>
