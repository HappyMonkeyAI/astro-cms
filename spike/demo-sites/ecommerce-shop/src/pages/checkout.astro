---
import Base from "../../layouts/Base.astro";
import { useState } from "react";

export const prerender = false;

// Mock cart items (in a real site, this would come from state or API)
const mockCartItems = [
	{ slug: "wireless-headphones", title: "Wireless Headphones", price: 7999, quantity: 1 },
	{ slug: "coffee-mug", title: "Ceramic Coffee Mug", price: 1499, quantity: 2 },
];

const formatPrice = (price: number) => {
	return `$${(price / 100).toFixed(2)}`;
};

const total = mockCartItems.reduce((sum, item) => sum + item.price * item.quantity, 0);
const shipping = total > 5000 ? 0 : 599; // Free shipping over $50
const grandTotal = total + shipping;

const [checkoutStatus, setCheckoutStatus] = useState<"idle" | "processing" | "success" | "error">("idle");
const [errorMessage, setErrorMessage] = useState("");

const handleCheckout = async () => {
	setCheckoutStatus("processing");

	// TODO: Integrate with Stripe checkout session API
	// For now, simulate a successful checkout
	setTimeout(() => {
		setCheckoutStatus("success");
	}, 1500);
};
---

<Base title="Checkout - E-commerce Demo Shop">
	<section class="checkout">
		<h1>Checkout</h1>

		{checkoutStatus === "success" && (
			<div class="checkout__success">
				<h2>Order Successful!</h2>
				<p>Thank you for your purchase. A confirmation email has been sent.</p>
				<a href="/" class="checkout__continue-shopping">Continue Shopping</a>
			</div>
		)}

		{checkoutStatus === "error" && (
			<div class="checkout__error">
				<p>{errorMessage}</p>
				<button class="checkout__retry" onClick={() => setCheckoutStatus("idle")}>Try Again</button>
			</div>
		)}

		{checkoutStatus === "idle" && (
			<div class="checkout__grid">
				<div class="checkout__form">
					<h2>Shipping Information</h2>
					<form class="checkout__fields" onSubmit={(e) => e.preventDefault()}>
						<div class="checkout__field-group">
							<label for="firstName">First Name *</label>
							<input type="text" id="firstName" required />
						</div>
						<div class="checkout__field-group">
							<label for="lastName">Last Name *</label>
							<input type="text" id="lastName" required />
						</div>
						<div class="checkout__field-group">
							<label for="email">Email Address *</label>
							<input type="email" id="email" required />
						</div>
						<div class="checkout__field-group">
							<label for="address">Address *</label>
							<input type="text" id="address" required />
						</div>
						<div class="checkout__field-group">
							<label for="city">City *</label>
							<input type="text" id="city" required />
						</div>
						<div class="checkout__field-group">
							<label for="zip">ZIP Code *</label>
							<input type="text" id="zip" required />
						</div>
					</form>
				</div>

				<div class="checkout__summary">
					<h2>Order Summary</h2>
					<ul class="checkout__items">
						{mockCartItems.map((item) => (
							<li class="checkout__item">
								<span>{item.title} x {item.quantity}</span>
								<span>{formatPrice(item.price * item.quantity)}</span>
							</li>
						))}
					</ul>
					<div class="checkout__totals">
						<div class="checkout__total-row">
							<span>Subtotal:</span>
							<span>{formatPrice(total)}</span>
						</div>
						<div class="checkout__total-row">
							<span>Shipping:</span>
							<span>{shipping === 0 ? "Free" : formatPrice(shipping)}</span>
						</div>
						<div class="checkout__total-row checkout__total-row--grand">
							<span>Total:</span>
							<span>{formatPrice(grandTotal)}</span>
						</div>
					</div>
					<button
						class="checkout__submit"
						onClick={handleCheckout}
						disabled={checkoutStatus === "processing"}
					>
						{checkoutStatus === "processing" ? "Processing..." : "Complete Order"}
					</button>
				</div>
			</div>
		)}
	</section>
</Base>

<style>
	.checkout {
		margin-top: 2rem;
	}

	.checkout h1 {
		font-size: 2rem;
		margin-bottom: 2rem;
	}

	.checkout__success,
	.checkout__error {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 2rem;
		text-align: center;
	}

	.checkout__success h2 {
		color: #166534;
		margin-bottom: 1rem;
	}

	.checkout__success p {
		margin-bottom: 1.5rem;
		color: var(--color-text-secondary);
	}

	.checkout__continue-shopping,
	.checkout__retry {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
		border-radius: var(--radius);
		font-weight: 600;
	}

	.checkout__grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 3rem;
	}

	@media (max-width: 768px) {
		.checkout__grid {
			grid-template-columns: 1fr;
		}
	}

	.checkout__form h2,
	.checkout__summary h2 {
		font-size: 1.25rem;
		margin-bottom: 1.5rem;
	}

	.checkout__fields {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.checkout__field-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.checkout__field-group label {
		font-weight: 500;
		color: var(--color-text);
	}

	.checkout__field-group input {
		padding: 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		font-size: 1rem;
	}

	.checkout__summary {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		height: fit-content;
	}

	.checkout__items {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem 0;
	}

	.checkout__item {
		display: flex;
		justify-content: space-between;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text-secondary);
	}

	.checkout__totals {
		margin-bottom: 1.5rem;
	}

	.checkout__total-row {
		display: flex;
		justify-content: space-between;
		padding: 0.5rem 0;
		color: var(--color-text-secondary);
	}

	.checkout__total-row--grand {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-text);
		border-top: 1px solid var(--color-border);
		margin-top: 0.5rem;
		padding-top: 1rem;
	}

	.checkout__submit {
		width: 100%;
		padding: 0.75rem;
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		border-radius: var(--radius);
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
	}

	.checkout__submit:hover:not(:disabled) {
		background: var(--color-brand-hover);
	}

	.checkout__submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
</style>
