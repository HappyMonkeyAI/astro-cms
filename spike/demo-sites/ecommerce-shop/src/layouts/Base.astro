---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";

export interface Props {
	title?: string;
	description?: string;
	cartCount?: number;
}

const { title = "E-commerce Demo Shop", description = "Browse and buy products online", cartCount = 0 } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<EmDashHead />
	</head>
	<body>
		<EmDashBodyStart />

		<header class="site-header">
			<nav class="nav">
				<a href="/" class="nav__logo">E-commerce Demo</a>
				<div class="nav__links">
					<a href="/">Products</a>
					<a href="/checkout" class="nav__cart">
						Checkout <span class="cart-count">{cartCount}</span>
					</a>
				</div>
			</nav>
		</header>

		<main class="site-main">
			<slot />
		</main>

		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} E-commerce Demo Shop. Powered by EmDash CMS.</p>
		</footer>

		<EmDashBodyEnd />
	</body>
</html>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
		padding: 1rem 0;
		position: sticky;
		top: 0;
		background: var(--color-bg);
		z-index: 100;
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 1rem;
	}

	.nav__logo {
		font-weight: 600;
		font-size: 1.25rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.nav__links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.nav__links a {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.nav__links a:hover {
		color: var(--color-text);
	}

	.nav__cart {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.cart-count {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border-radius: 50%;
		width: 20px;
		height: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.site-main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: 2rem 0;
		text-align: center;
		color: var(--color-text-secondary);
		margin-top: 4rem;
	}
</style>
