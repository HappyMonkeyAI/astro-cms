---
import Base from "../layouts/Base.astro";
import MenuItem from "../components/MenuItem.astro";
import ReservationForm from "../components/ReservationForm.astro";

export const prerender = false;

// Mock menu data organized by categories
const menuData = {
	appetizers: [
		{
			id: "app-1",
			name: "Calamari Fritti",
			description: "Crispy fried calamari served with lemon aioli and marinara sauce.",
			price: 14.99,
			category: "appetizers",
			dietaryTags: ["gluten-free"],
		},
		{
			id: "app-2",
			name: "Bruschetta",
			description: "Toasted bread topped with fresh tomatoes, garlic, basil, and extra virgin olive oil.",
			price: 10.99,
			category: "appetizers",
			dietaryTags: ["vegetarian", "vegan"],
		},
		{
			id: "app-3",
			name: "Spicy Tuna Tartare",
			description: "Fresh tuna with avocado, sesame, and a spicy mayo drizzle.",
			price: 16.99,
			category: "appetizers",
			dietaryTags: ["spicy"],
		},
	],
	mains: [
		{
			id: "main-1",
			name: "Grilled Salmon",
			description: "Atlantic salmon fillet with lemon butter sauce, served with seasonal vegetables.",
			price: 26.99,
			category: "mains",
			dietaryTags: ["gluten-free", "dairy-free"],
		},
		{
			id: "main-2",
			name: "Chicken Parmigiana",
			description: "Breaded chicken breast with marinara sauce and melted mozzarella, served with pasta.",
			price: 22.99,
			category: "mains",
		},
		{
			id: "main-3",
			name: "Mushroom Risotto",
			description: "Creamy arborio rice with wild mushrooms, parmesan, and fresh herbs.",
			price: 19.99,
			category: "mains",
			dietaryTags: ["vegetarian"],
		},
		{
			id: "main-4",
			name: "Spicy Thai Curry",
			description: "Red curry with coconut milk, vegetables, and your choice of protein.",
			price: 18.99,
			category: "mains",
			dietaryTags: ["vegan", "gluten-free", "spicy"],
		},
	],
	desserts: [
		{
			id: "des-1",
			name: "Tiramisu",
			description: "Classic Italian dessert with espresso-soaked ladyfingers and mascarpone cream.",
			price: 9.99,
			category: "desserts",
		},
		{
			id: "des-2",
			name: "Vegan Chocolate Cake",
			description: "Rich chocolate cake made with plant-based ingredients, served with vegan vanilla ice cream.",
			price: 10.99,
			category: "desserts",
			dietaryTags: ["vegan"],
		},
	],
};
---

<Base title="Restaurant Menu Demo - Browse Our Menu & Make a Reservation">
	<section class="hero">
		<h1>Experience Fine Dining</h1>
		<p class="hero__lead">
			Fresh ingredients, expert chefs, and a warm atmosphere. Browse our menu or make a reservation today.
		</p>
	</section>

	<section class="menu-section">
		<h2>Our Menu</h2>

		{Object.entries(menuData).map(([category, items]) => (
			<section class="menu-category" id={category}>
				<h3 class="menu-category__title">{category.charAt(0).toUpperCase() + category.slice(1)}</h3>
				<div class="menu-items">
					{items.map((item) => (
						<MenuItem item={item} />
					))}
				</div>
			</section>
		))}
	</section>

	<section class="reservations-section">
		<h2>Make a Reservation</h2>
		<p class="reservations-section__lead">
			Book a table for dinner, lunch, or a special occasion. We look forward to hosting you.
		</p>
		<ReservationForm />
	</section>
</Base>

<style>
	.hero {
		text-align: center;
		padding: 4rem 0;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 3rem;
		background: var(--color-fill);
	}

	.hero h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
		color: var(--color-text);
	}

	.hero__lead {
		font-size: 1.25rem;
		color: var(--color-text-secondary);
		max-width: 700px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.menu-section {
		margin-bottom: 4rem;
	}

	.menu-section h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
		text-align: center;
	}

	.menu-category {
		margin-bottom: 3rem;
	}

	.menu-category__title {
		font-size: 1.5rem;
		font-weight: 600;
		margin-bottom: 1.5rem;
		color: var(--color-text);
		border-bottom: 2px solid var(--color-brand);
		padding-bottom: 0.5rem;
		display: inline-block;
	}

	.menu-items {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.reservations-section {
		margin-top: 4rem;
		padding-top: 3rem;
		border-top: 1px solid var(--color-border);
	}

	.reservations-section h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
		text-align: center;
	}

	.reservations-section__lead {
		text-align: center;
		color: var(--color-text-secondary);
		margin-bottom: 2rem;
	}
</style>
