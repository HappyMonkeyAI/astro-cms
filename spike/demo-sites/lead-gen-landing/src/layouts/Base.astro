---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";

export interface Props {
	title?: string;
	description?: string;
}

const { title = "Lead Generation Demo", description = "Convert visitors into leads" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<EmDashHead />
		<!-- Conversion tracking placeholders -->
		<!-- Google Analytics: <script async src="https://www.googletagmanager.com/gtag/js?id=GA_MEASUREMENT_ID"></script> -->
		<!-- Meta Pixel: <script>!function(f,b,e,v,n,t,s){...}</script> -->
	</head>
	<body>
		<EmDashBodyStart />

		<header class="site-header">
			<nav class="nav">
				<a href="/" class="nav__logo">Lead Gen Demo</a>
			</nav>
		</header>

		<main class="site-main">
			<slot />
		</main>

		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} Lead Generation Demo. Powered by EmDash CMS.</p>
		</footer>

		<EmDashBodyEnd />
	</body>
</html>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
		padding: 1rem 0;
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 1rem;
	}

	.nav__logo {
		font-weight: 600;
		font-size: 1.25rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.site-main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: 2rem 0;
		text-align: center;
		color: var(--color-text-secondary);
		margin-top: 4rem;
	}
</style>
