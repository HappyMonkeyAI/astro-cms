---
import { useState } from "react";

export interface Props {
	onSubmit?: (data: any) => void;
}

const { onSubmit } = Astro.props;

const [step, setStep] = useState(1);
const [formData, setFormData] = useState({
	fullName: "",
	email: "",
	phone: "",
	company: "",
	interest: "",
	budget: "",
	message: "",
});

const [status, setStatus] = useState<"idle" | "submitting" | "success" | "error">("idle");
const [errorMessage, setErrorMessage] = useState("");

const handleChange = (field: string, value: string) => {
	setFormData((prev) => ({ ...prev, [field]: value }));
};

const nextStep = () => {
	// Validate current step
	if (step === 1 && (!formData.fullName || !formData.email)) {
		setErrorMessage("Please fill in your name and email.");
		return;
	}
	if (step === 2 && !formData.interest) {
		setErrorMessage("Please select your area of interest.");
		return;
	}
	setStep((prev) => Math.min(prev + 1, 3));
	setErrorMessage("");
};

const prevStep = () => {
	setStep((prev) => Math.max(prev - 1, 1));
	setErrorMessage("");
};

const handleSubmit = async (e: Event) => {
	e.preventDefault();
	setStatus("submitting");

	try {
		// TODO: Integrate with CRM (HubSpot, Mailchimp) or form API
		await new Promise((resolve) => setTimeout(resolve, 1000));

		if (onSubmit) {
			onSubmit(formData);
		}

		setStatus("success");
	} catch (error) {
		setErrorMessage("Failed to submit form. Please try again.");
		setStatus("error");
	}
};

const interestOptions = [
	"Consulting Services",
	"Software Development",
	"Marketing & SEO",
	"Design & Branding",
	"Other",
];

const budgetOptions = [
	"< $5,000",
	"$5,000 - $10,000",
	"$10,000 - $25,000",
	"$25,000+",
	"Not sure yet",
];
---

<section class="multi-step-form">
	{status === "success" && (
		<div class="multi-step-form__success">
			<h2>Thank You!</h2>
			<p>We've received your information and will be in touch shortly.</p>
			<button class="multi-step-form__reset" onClick={() => { setStep(1); setFormData({ fullName: "", email: "", phone: "", company: "", interest: "", budget: "", message: "" }); setStatus("idle"); }}>
				Submit Another Request
			</button>
		</div>
	)}

	{status !== "success" && (
		<>
			<div class="multi-step-form__progress">
				<div class={`multi-step-form__step ${step >= 1 ? "multi-step-form__step--active" : ""}`}>1</div>
				<div class="multi-step-form__step-line"></div>
				<div class={`multi-step-form__step ${step >= 2 ? "multi-step-form__step--active" : ""}`}>2</div>
				<div class="multi-step-form__step-line"></div>
				<div class={`multi-step-form__step ${step >= 3 ? "multi-step-form__step--active" : ""}`}>3</div>
			</div>

			{errorMessage && <div class="multi-step-form__error">{errorMessage}</div>}

			<form onSubmit={handleSubmit} class="multi-step-form__fields">
				{step === 1 && (
					<div class="multi-step-form__step-content">
						<h2>Step 1: Your Information</h2>
						<div class="multi-step-form__group">
							<label for="fullName">Full Name *</label>
							<input
								type="text"
								id="fullName"
								value={formData.fullName}
								onChange={(e) => handleChange("fullName", (e.target as HTMLInputElement).value)}
								required
							/>
						</div>
						<div class="multi-step-form__group">
							<label for="email">Email Address *</label>
							<input
								type="email"
								id="email"
								value={formData.email}
								onChange={(e) => handleChange("email", (e.target as HTMLInputElement).value)}
								required
							/>
						</div>
						<div class="multi-step-form__group">
							<label for="phone">Phone Number</label>
							<input
								type="tel"
								id="phone"
								value={formData.phone}
								onChange={(e) => handleChange("phone", (e.target as HTMLInputElement).value)}
							/>
						</div>
						<div class="multi-step-form__group">
							<label for="company">Company Name</label>
							<input
								type="text"
								id="company"
								value={formData.company}
								onChange={(e) => handleChange("company", (e.target as HTMLInputElement).value)}
							/>
						</div>
						<button type="button" class="multi-step-form__next" onClick={nextStep}>
							Next Step
						</button>
					</div>
				)}

				{step === 2 && (
					<div class="multi-step-form__step-content">
						<h2>Step 2: Your Interest</h2>
						<div class="multi-step-form__group">
							<label for="interest">What are you interested in? *</label>
							<select
								id="interest"
								value={formData.interest}
								onChange={(e) => handleChange("interest", (e.target as HTMLSelectElement).value)}
								required
							>
								<option value="">Select an option...</option>
								{interestOptions.map((option) => (
									<option value={option}>{option}</option>
								))}
							</select>
						</div>
						<div class="multi-step-form__group">
							<label for="budget">Estimated Budget</label>
							<select
								id="budget"
								value={formData.budget}
								onChange={(e) => handleChange("budget", (e.target as HTMLSelectElement).value)}
							>
								<option value="">Select a range...</option>
								{budgetOptions.map((option) => (
									<option value={option}>{option}</option>
								))}
							</select>
						</div>
						<div class="multi-step-form__actions">
							<button type="button" class="multi-step-form__prev" onClick={prevStep}>
								Previous
							</button>
							<button type="button" class="multi-step-form__next" onClick={nextStep}>
								Next Step
							</button>
						</div>
					</div>
				)}

				{step === 3 && (
					<div class="multi-step-form__step-content">
						<h2>Step 3: Additional Details</h2>
						<div class="multi-step-form__group">
							<label for="message">Tell us more about your project</label>
							<textarea
								id="message"
								rows={5}
								value={formData.message}
								onChange={(e) => handleChange("message", (e.target as HTMLTextAreaElement).value)}
							></textarea>
						</div>
						<div class="multi-step-form__honeypot" style={{ display: "none" }}>
							<label for="honeypot">Leave this field empty</label>
							<input
								type="text"
								id="honeypot"
								name="honeypot"
								value={formData.honeypot || ""}
								onChange={(e) => handleChange("honeypot", (e.target as HTMLInputElement).value)}
							/>
						</div>
						<div class="multi-step-form__actions">
							<button type="button" class="multi-step-form__prev" onClick={prevStep}>
								Previous
							</button>
							<button type="submit" class="multi-step-form__submit" disabled={status === "submitting"}>
								{status === "submitting" ? "Submitting..." : "Submit Request"}
							</button>
						</div>
					</div>
				)}
			</form>
		</>
	)}
</section>

<style>
	.multi-step-form {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 2rem;
		margin-top: 2rem;
	}

	.multi-step-form__progress {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 2rem;
	}

	.multi-step-form__step {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--color-fill);
		border: 2px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	.multi-step-form__step--active {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: var(--color-on-brand);
	}

	.multi-step-form__step-line {
		flex: 1;
		height: 2px;
		background: var(--color-border);
		margin: 0 0.5rem;
	}

	.multi-step-form__error {
		background: #fee2e2;
		color: #991b1b;
		padding: 0.75rem;
		border-radius: var(--radius);
		margin-bottom: 1rem;
		text-align: center;
	}

	.multi-step-form__success {
		text-align: center;
		padding: 2rem;
	}

	.multi-step-form__success h2 {
		color: #166534;
		margin-bottom: 1rem;
	}

	.multi-step-form__success p {
		color: var(--color-text-secondary);
		margin-bottom: 1.5rem;
	}

	.multi-step-form__reset {
		padding: 0.75rem 1.5rem;
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		border-radius: var(--radius);
		font-weight: 600;
		cursor: pointer;
	}

	.multi-step-form__fields {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.multi-step-form__group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.multi-step-form__group label {
		font-weight: 500;
		color: var(--color-text);
	}

	.multi-step-form__group input,
	.multi-step-form__group select,
	.multi-step-form__group textarea {
		padding: 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		font-size: 1rem;
		background: var(--color-bg);
		color: var(--color-text);
	}

	.multi-step-form__group input:focus,
	.multi-step-form__group select:focus,
	.multi-step-form__group textarea:focus {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.multi-step-form__actions {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.multi-step-form__next,
	.multi-step-form__prev,
	.multi-step-form__submit {
		padding: 0.75rem 1.5rem;
		border: none;
		border-radius: var(--radius);
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
	}

	.multi-step-form__next,
	.multi-step-form__submit {
		background: var(--color-brand);
		color: var(--color-on-brand);
		flex: 1;
	}

	.multi-step-form__next:hover,
	.multi-step-form__submit:hover:not(:disabled) {
		background: var(--color-brand-hover);
	}

	.multi-step-form__submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.multi-step-form__prev {
		background: var(--color-fill);
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}

	.multi-step-form__prev:hover {
		background: var(--color-border);
	}

	.multi-step-form__honeypot {
		display: none !important;
	}
</style>
