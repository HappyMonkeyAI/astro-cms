# {{siteName}}: generated by `astro-cms new` on {{created}}. Never commit this file.
# Back it up with the database: EMDASH_ENCRYPTION_KEY decrypts stored secrets (SMTP, plugin settings).

SITE_NAME={{siteName}}
DOMAIN={{domain}}
SITE_PORT={{port}}
ASTRO_CMS_IMAGE={{image}}

# Public URL of the site (used for links in emails and OAuth redirects)
EMDASH_SITE_URL={{siteUrl}}

POSTGRES_PASSWORD={{postgresPassword}}
EMDASH_ENCRYPTION_KEY={{encryptionKey}}

# Locks the setup wizard until it's opened with the setup link (README.md). Inert once setup is done.
ASTRO_CMS_SETUP_TOKEN={{setupToken}}

# Email: magic links, invitations, password reset and 2FA codes
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Sign in with Google / Microsoft (one OAuth app per client site)
# EMDASH_OAUTH_GOOGLE_CLIENT_ID=
# EMDASH_OAUTH_GOOGLE_CLIENT_SECRET=
# EMDASH_OAUTH_MICROSOFT_CLIENT_ID=
# EMDASH_OAUTH_MICROSOFT_CLIENT_SECRET=
# EMDASH_OAUTH_MICROSOFT_TENANT_ID=

# Search language for Postgres full-text search (english, simple, german, french, ...)
# PG_SEARCH_CONFIG=english
