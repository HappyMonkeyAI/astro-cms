import type { PluginContext, SandboxedPlugin } from "emdash/plugin";
import { z } from "zod";

/**
 * {{slug}}: {{description}}
 *
 * Generated by `astro-cms plugin new`. Read skills/creating-plugins/SKILL.md and
 * skills/creating-plugins/ASTRO-CMS.md before extending it.
 */

type Ctx = PluginContext;

interface EventRecord {
	at: string;
	message: string;
}

const events = (ctx: Ctx) => ctx.storage.events;

// Route input arrives as JSON for POST, and as strings from the query for GET:
// use z.coerce for numbers and booleans.
const pingInput = z.object({ message: z.string().max(200).optional() });
const listInput = z.object({ limit: z.coerce.number().int().min(1).max(100).optional() });

const adminInput = z.discriminatedUnion("type", [
	z.object({ type: z.literal("page_load"), page: z.string() }),
	z.object({ type: z.literal("block_action"), action_id: z.string(), value: z.unknown().optional() }),
]);

async function adminPage(ctx: Ctx, toast?: { type: "success" | "error"; message: string }) {
	const recent = await events(ctx).query({ orderBy: { at: "desc" }, limit: 10 });
	return {
		blocks: [
			{ type: "header", text: "{{title}}" },
			{ type: "context", text: "{{description}}" },
			{ type: "actions", elements: [{ type: "button", label: "Record an event", action_id: "record", style: "primary" }] },
			{
				type: "table",
				columns: [
					{ key: "at", label: "When" },
					{ key: "message", label: "Message" },
				],
				rows: recent.items.map((i) => i.data as EventRecord),
				empty_text: "No events yet.",
			},
		],
		...(toast ? { toast } : {}),
	};
}

const plugin: SandboxedPlugin = {
	routes: {
		ping: {
			methods: ["POST"],
			handler: async (routeCtx, ctx) => {
				const parsed = pingInput.safeParse(routeCtx.input ?? {});
				if (!parsed.success) return { ok: false, error: "INVALID_INPUT" };
				const record: EventRecord = { at: new Date().toISOString(), message: parsed.data.message ?? "ping" };
				await events(ctx).put(`${record.at}:${crypto.randomUUID()}`, record);
				return { ok: true, record };
			},
		},
		events: {
			handler: async (routeCtx, ctx) => {
				const parsed = listInput.safeParse(routeCtx.input ?? {});
				if (!parsed.success) return { ok: false, error: "INVALID_INPUT" };
				const result = await events(ctx).query({ orderBy: { at: "desc" }, limit: parsed.data.limit ?? 20 });
				return { ok: true, items: result.items.map((i) => i.data) };
			},
		},
		admin: {
			handler: async (routeCtx, ctx) => {
				const parsed = adminInput.safeParse(routeCtx.input);
				if (!parsed.success) return { blocks: [] };
				if (parsed.data.type === "block_action" && parsed.data.action_id === "record") {
					const record: EventRecord = { at: new Date().toISOString(), message: "Recorded from the admin page" };
					await events(ctx).put(`${record.at}:${crypto.randomUUID()}`, record);
					return adminPage(ctx, { type: "success", message: "Event recorded." });
				}
				return adminPage(ctx);
			},
		},
	},
};

export default plugin;
