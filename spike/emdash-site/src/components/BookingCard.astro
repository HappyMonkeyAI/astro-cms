---
interface Props {
	service: string;
	date: string;
	time: string;
	status: "pending" | "confirmed" | "cancelled";
	customerName?: string | null;
	notes?: string | null;
}

const { service, date, time, status, customerName, notes } = Astro.props;
---

<article class="booking-card" data-status={status}>
	<header class="booking-card__header">
		<span class="booking-card__service">{service}</span>
		<span class={`booking-card__status booking-card__status--${status}`}>
			{status}
		</span>
	</header>
	<dl class="booking-card__details">
		<div>
			<dt>Date</dt>
			<dd>{date}</dd>
		</div>
		<div>
			<dt>Time</dt>
			<dd>{time}</dd>
		</div>
		{customerName && (
			<div>
				<dt>Booked for</dt>
				<dd>{customerName}</dd>
			</div>
		)}
	</dl>
	{notes && <p class="booking-card__notes">{notes}</p>}
</article>

<style>
	.booking-card {
		border: 1px solid rgba(127, 127, 127, 0.25);
		border-radius: 0.75rem;
		padding: 1.25rem;
		background: var(--color-surface, #ffffff);
	}

	.booking-card__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.9rem;
	}

	.booking-card__service {
		font-weight: 600;
		text-transform: capitalize;
	}

	.booking-card__status {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: rgba(127, 127, 127, 0.14);
	}

	.booking-card__status--confirmed {
		background: rgba(22, 163, 74, 0.14);
		color: #166534;
	}

	.booking-card__status--pending {
		background: rgba(217, 119, 6, 0.14);
		color: #92400e;
	}

	.booking-card__status--cancelled {
		background: rgba(220, 38, 38, 0.14);
		color: #991b1b;
	}

	.booking-card__details {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		gap: 0.75rem;
		margin: 0;
	}

	.booking-card__details dt {
		font-size: 0.75rem;
		opacity: 0.7;
	}

	.booking-card__details dd {
		margin: 0.15rem 0 0;
		font-weight: 500;
	}

	.booking-card__notes {
		margin: 0.9rem 0 0;
		font-size: 0.9rem;
		opacity: 0.85;
	}
</style>
